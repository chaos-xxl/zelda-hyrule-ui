{
  "name": "zelda-hyrule-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for zelda-hyrule-ui (React) and zelda-hyrule-ui-vue (Vue 3) — unofficial, non-commercial fan-made UI component libraries inspired by The Legend of Zelda: Breath of the Wild. Not affiliated with or endorsed by Nintendo.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chaos-xxl/zelda-hyrule-ui"
  },
  "author": "Chaos",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "npm run build --workspace zelda-hyrule-ui",
    "build:demo": "vite build --config vite.config.demo.ts",
    "deploy": "npm run build:demo && gh-pages -d demo-dist"
  },
  "devDependencies": {
    "@laynezh/vite-plugin-lib-assets": "^2.1.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "glob": "^11.0.1",
    "less": "^4.2.1",
    "playwright": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
